generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RemotePreference {
  required
  allowed
  not_allowed
}

enum OutboxStatus {
  pending
  processing
  sent
  failed
}

// ─── Alert ────────────────────────────────────────────────────────────────────

model Alert {
  id               String           @id @default(cuid())
  userId           String
  rawText          String
  roles            String[]
  skills           String[]
  locations        String[]
  remotePreference RemotePreference @default(allowed)
  excludeTerms     String[]
  unknowns         String[]         // fields LLM couldn't parse
  parseFallback    Boolean          @default(false) // true = used deterministic fallback
  promptVersion    String?          // which prompt version parsed this
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  matches          JobMatch[]

  @@index([userId])
}

// ─── Job ──────────────────────────────────────────────────────────────────────

model Job {
  id              String   @id @default(cuid())
  sourceId        String   @unique          // external feed ID
  title           String
  company         String
  description     String
  location        String
  remote          Boolean  @default(false)
  skills          String[]
  contentHash     String                    // SHA-256 of stable content fields
  // Stable content fields ↑ — changing these triggers a content-changed event
  // Volatile freshness fields ↓ — update these without rewriting the stable row
  observedAt      DateTime @default(now()) // last time feed saw this job
  sourceFileDate  DateTime?                // date of the source feed file
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         JobMatch[]

  @@index([contentHash])
  @@index([location])
  @@index([remote])
  @@index([skills])            // GIN index added in migration manually
  @@index([createdAt])
}

// ─── Job staging (bulk ingest buffer) ────────────────────────────────────────

model JobStaging {
  id             String   @id @default(cuid())
  sourceId       String
  title          String
  company        String
  description    String
  location       String
  remote         Boolean  @default(false)
  skills         String[]
  contentHash    String
  observedAt     DateTime
  sourceFileDate DateTime?
  ingestBatchId  String                    // group records from one ingest run
  createdAt      DateTime @default(now())

  @@index([ingestBatchId])
  @@index([sourceId])
  @@index([contentHash])
}

// ─── Job match ────────────────────────────────────────────────────────────────

model JobMatch {
  id        String   @id @default(cuid())
  alertId   String
  jobId     String
  score     Int
  reasons   String[]                       // human-readable match explanations
  createdAt DateTime @default(now())

  alert     Alert    @relation(fields: [alertId], references: [id])
  job       Job      @relation(fields: [jobId], references: [id])

  @@unique([alertId, jobId])              // dedup guard — no double notifications
  @@index([alertId])
  @@index([jobId])
}

// ─── Notification outbox ──────────────────────────────────────────────────────

model NotificationOutbox {
  id           String       @id @default(cuid())
  userId       String
  alertId      String
  jobIds       String[]                    // digest: multiple jobs per email
  status       OutboxStatus @default(pending)
  attempts     Int          @default(0)
  failedReason String?                     // last error message on failure
  processedAt  DateTime?                   // when sent or permanently failed
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])            // worker query: fetch pending batches
  @@index([userId])
  @@index([alertId])
}